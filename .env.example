# Optional: absolute control plane URL (e.g. prod or CORS testing in dev).
# In dev, if unset: empty default URL → /api and /auth requests proxied by Vite to localhost:5555.
# PUBLIC_RESHAPR_SERVER=http://localhost:5555

# SaaS OAuth callback (only if Reshapr allowlisted your deployed URL; dev uses http://localhost:<vite-port>).
# PUBLIC_RESHAPR_SAAS_REDIRECT_URI=https://your-app.vercel.app/login/callback
